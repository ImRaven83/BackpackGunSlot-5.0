<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- SPT 5.0 runs EFT on IL2CPP with BepInEx 6, whose runtime is .NET 10. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BackpackGunSlot</AssemblyName>
    <RootNamespace>BackpackGunSlot</RootNamespace>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Version>$(AssemblyVersion)</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);server\**;release\**</DefaultItemExcludes>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Point this at an SPT 5.0 install that has been started once, so BepInEx has
       generated BepInEx\interop: dotnet build -c Release -p:TarkovDir="D:\SPT 5.0\" -->
  <PropertyGroup>
    <TarkovDir Condition="'$(TarkovDir)' == ''">C:\SPT\</TarkovDir>
    <TarkovDir Condition="!HasTrailingSlash('$(TarkovDir)')">$(TarkovDir)\</TarkovDir>
    <BepInExCoreDir>$(TarkovDir)BepInEx\core\</BepInExCoreDir>
    <BepInExInteropDir>$(TarkovDir)BepInEx\interop\</BepInExInteropDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCoreDir)BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCoreDir)BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCoreDir)0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExCoreDir)Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(BepInExCoreDir)Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExInteropDir)*.dll" Private="false" />
  </ItemGroup>

  <!-- The ghost icons are optional at runtime: without them SMG and shotgun slots fall back to the rifle ghost. -->
  <ItemGroup>
    <EmbeddedResource Include="assets\smg.png" LogicalName="BackpackGunSlot.smg.png" Condition="Exists('assets\smg.png')" />
    <EmbeddedResource Include="assets\shotgun.png" LogicalName="BackpackGunSlot.shotgun.png" Condition="Exists('assets\shotgun.png')" />
  </ItemGroup>

  <Target Name="WarnMissingIcons" BeforeTargets="Build" Condition="!Exists('assets\smg.png') Or !Exists('assets\shotgun.png')">
    <Warning Text="assets\smg.png or assets\shotgun.png is missing; SMG and shotgun slots will show the rifle ghost." />
  </Target>

</Project>
